---
/** Small illustration for the "Endless scroll ready" feature card.
 */
const rows = [
  [1.4, 0.9, 1.6],
  [1.1, 1.3, 0.8, 1.5],
  [1.7, 1.0, 1.2],
  [0.9, 1.4, 1.1, 1.3],
];
const track = [...rows, ...rows];
---

<div class="jg-endless-demo" aria-hidden="true">
  <div class="jg-endless-track">
    {
      track.map((row) => (
        <div class="jg-endless-row">
          {row.map((w) => (
            <span class="jg-endless-block" style={`flex-grow: ${w};`} />
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .jg-endless-demo {
    height: 4.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
  }

  .jg-endless-track {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    animation: jg-endless-scroll 9s linear infinite;
  }

  .jg-endless-row {
    display: flex;
    gap: 0.3rem;
    height: 1.1rem;
    flex: none;
  }

  .jg-endless-block {
    flex-basis: 0;
    min-width: 0;
    border-radius: 0.2rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sl-color-accent) 55%, transparent),
      color-mix(in srgb, var(--sl-color-accent-high) 30%, transparent)
    );
  }

  @keyframes jg-endless-scroll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jg-endless-track {
      animation: none;
    }
  }
</style>
